# Rappi Analytics Backend
# Copy this file to .env in the backend root and fill the values you need.

# -----------------------------------------------------------------------------
# FastAPI server
# -----------------------------------------------------------------------------

# Host used by run_api.py / uvicorn. Use 0.0.0.0 to accept local network traffic.
API_HOST=0.0.0.0

# Backend port. The frontend proxy expects 8000 by default.
API_PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by knowledge-base/database helpers.
# The app can still answer chat/agent requests without Postgres, but endpoints
# that clear or persist database data need this server running.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rappi_analytics

# -----------------------------------------------------------------------------
# AI / OSINT search
# -----------------------------------------------------------------------------

# Google AI Studio key used by the optional Pydantic AI Gemini agent.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# SerpApi key used to run Google OSINT searches for live platform evidence.
# Get one at: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Backward-compatible alias accepted by the code. Prefer SERPAPI_API_KEY.
SERAPI_API_KEY=

# Optional model selector kept for local experiments/documentation.
# Current code defaults to gemini-2.0-flash when GEMINI_API_KEY is set.
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Scraping behavior
# -----------------------------------------------------------------------------

# Delay range between scraper actions, in seconds. Larger values are slower but
# gentler on target sites.
SCRAPER_DELAY_MIN=3.0
SCRAPER_DELAY_MAX=6.0

# Browser User-Agent used by Playwright helpers. Leave empty to use the default.
SCRAPER_USER_AGENT=

# Optional captcha solver provider. Supported values:
# 2captcha, capsolver, anti-captcha, anticaptcha.
SCRAPER_CAPTCHA_PROVIDER=

# API key for the captcha provider above. Leave empty if you do not use one.
SCRAPER_CAPTCHA_API_KEY=
